# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.
APP_URL=https://your-project.vercel.app
DATABASE_URL=            # added automatically by the Neon integration
SLACK_BOT_TOKEN=         # Slack app → OAuth & Permissions → Bot User OAuth Token (xoxb-…)
SLACK_SIGNING_SECRET=    # Slack app → Basic Information → Signing Secret
GOOGLE_CLIENT_ID=        # Google Cloud → APIs & Services → Credentials → OAuth client
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=          # 32 random bytes, base64 (encrypts Google refresh tokens)
CRON_SECRET=             # random string; Vercel sends it to the daily cron job
